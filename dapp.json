{
  "description": "Old skool adventure game",
  "icon": { "image": "brand/icon.png" },
  "secrets": [],
  "tests": [
    {
      "name": "Hub shows each game's poster banner",
      "path": "/",
      "expectSelector": "#cards .game-card .card-poster"
    },
    {
      "id": "hub.hub-renders",
      "name": "Hub shows game cards and leaderboard",
      "path": "/",
      "expectSelector": "#cards .game-card",
      "expectText": "TOP SCOUTS",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    },
    {
      "id": "game.title-screen",
      "name": "Lost Starways game screen loads",
      "path": "/play",
      "expectSelector": "#screen",
      "expectText": "STARWAYS 64",
      "visual": true,
      "impact": [
        "public/index.html",
        "public/fonts.css",
        "server.js"
      ]
    },
    {
      "id": "game.input-under-picture",
      "name": "Command input sits under the picture",
      "path": "/play",
      "expectSelector": "#pic + #cmdline"
    },
    {
      "id": "game.lobby-button",
      "name": "Lobby button sits next to SND",
      "path": "/play",
      "expectSelector": "#keys button[data-cmd='sound'] ~ button[data-cmd='hub']",
      "expectText": "Lobby"
    },
    {
      "id": "dracula.input-under-picture",
      "name": "Dracula command input sits under the picture",
      "path": "/dracula",
      "expectSelector": "#pic + #cmdline"
    },
    {
      "id": "dracula.arrival-scene",
      "name": "Dracula has an arrival scene panel",
      "path": "/dracula",
      "expectSelector": "#arrival .arrival-art"
    },
    {
      "id": "game.dracula-title-screen",
      "name": "Escape from Dracula game screen loads",
      "path": "/dracula",
      "expectSelector": "#screen",
      "expectText": "VAMPIRE ESCAPE",
      "visual": true,
      "impact": [
        "public/dracula.html",
        "public/games.json",
        "server.js"
      ]
    },
    {
      "name": "Dracula sound toggle shows its state",
      "path": "/dracula",
      "expectText": "SND ON"
    },
    {
      "id": "game.more-paging",
      "name": "Long text pages up with a MORE prompt",
      "path": "/play?demo=more",
      "expectSelector": "#morebar:not(.hidden) #more",
      "expectText": "MORE",
      "visual": true,
      "impact": [
        "public/index.html"
      ]
    },
    {
      "id": "dracula.more-paging",
      "name": "Dracula long text pages up with a MORE prompt",
      "path": "/dracula?demo=more",
      "expectSelector": "#morebar:not(.hidden) #more",
      "expectText": "MORE",
      "visual": true,
      "impact": [
        "public/dracula.html"
      ]
    },
    {
      "id": "game.more-typed-command",
      "name": "Typing a command while MORE shows runs it",
      "path": "/play?demo=more&say=look",
      "expectText": "> LOOK"
    },
    {
      "id": "dracula.more-typed-command",
      "name": "Dracula: typing a command while MORE shows runs it",
      "path": "/dracula?demo=more&say=look",
      "expectText": "> LOOK"
    },
    {
      "name": "PWA manifest is served",
      "path": "/manifest.webmanifest",
      "expectText": "Lost Starways"
    },
    {
      "name": "Hub links the PWA manifest and icon",
      "path": "/",
      "expectSelector": "link[rel='manifest'][href='/manifest.webmanifest']"
    },
    {
      "id": "pwa.manifest",
      "name": "Web app manifest lists the home-screen icons",
      "path": "/manifest.json",
      "expectText": "icon-512.png"
    }
  ],
  "governance": {
    "approvers": "invited",
    "approvals": "default"
  },
  "visibility": {
    "build": "private",
    "view": "public"
  }
}
